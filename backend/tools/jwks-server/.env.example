# JWKS Server — Environment Variables
# Copy this file to .env for local testing. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────

# Server port (default: 3001)
PORT=3001

# JWKS payload — JSON string of the RSA public key in JWK Set format.
# Contains ONLY the public fields (kty, n, e, use, kid, alg).
# NEVER include the private key fields (d, p, q, dp, dq, qi).
#
# How to generate (run locally, never commit output):
#   1. openssl genrsa -out admin-private.pem 2048
#   2. openssl rsa -in admin-private.pem -pubout -out admin-public.pem
#   3. node make-jwks.js        <- generates jwks.json from admin-public.pem
#   4. Copy the content of jwks.json into this variable (one line, escaped)
#
# Set in Railway:
#   railway variables set "ADMIN_JWKS_PAYLOAD=..." --service jwks-server
#
# Template (replace n with real base64url-encoded modulus):
# ADMIN_JWKS_PAYLOAD={"keys":[{"kty":"RSA","n":"<base64url-modulus>","e":"AQAB","use":"sig","kid":"admin-key-1","alg":"RS256"}]}
